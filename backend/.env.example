# Backend Environment Variables

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/niangelos?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
# REQUIRED in production: a strong random secret (e.g. `openssl rand -hex 32`).
# The app refuses to boot with a placeholder secret when NODE_ENV=production.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# App
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
# Alternate frontend origin (extra CORS origin). Used by main.ts.
FRONTEND_URL_2=""
# Base URL used to build absolute links in emails.
APP_URL="http://localhost:3000"
# Demo login backdoor — leave "false" in production.
ENABLE_DEMO_LOGIN="false"

# Super admin bootstrap (used by auth service when the account is missing)
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# Observability
# Error tracking (optional). Leave blank to disable Sentry.
SENTRY_DSN=""
SENTRY_SAMPLE_RATE="0.1"

# File Storage
STORAGE_TYPE="local"
STORAGE_PATH="./uploads"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Cloudinary (set these for persistent file storage in production)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email
# SendGrid is the active provider (see mail.service.ts). SMTP_* above are legacy/documented drift.
SENDGRID_API_KEY=""
MAIL_FROM="noreply@niangelos.app"
MAIL_TO=""
EMAIL_FROM="noreply@niangelos.app"

# AI (announcements content generation)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# SMS (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Push Notifications (Firebase)
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""

# Search
MEILISEARCH_URL="http://localhost:7700"
MEILISEARCH_API_KEY=""

# Analytics
POSTHOG_KEY=""
POSTHOG_HOST=""

# Cloudflare R2 (hymn/subject-item recording storage)
# Set the R2 bucket to "Public" (bucket-level) so objects are readable via CLOUDFLARE_R2_PUBLIC_URL.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_URL=
