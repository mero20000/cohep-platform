# COHEP frontend environment (Next.js).
# Copy to .env.local and adjust for your environment.

# Base URL of the NestJS backend API, including the /api prefix, e.g.
#   http://localhost:3001/api    (local dev)
#   https://<backend>.onrender.com/api   (Render)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Base URL used to resolve uploaded-file URLs (no /api suffix).
# e.g. https://<backend>.onrender.com
NEXT_PUBLIC_UPLOADS_URL=

# Server-only: backend origin used by next.config rewrites / image remote patterns.
# Falls back to NEXT_PUBLIC_API_URL.
API_URL=http://localhost:3001